# Copy to server/.env for local dev and fill in the values.

# Postgres connection string. Locally you can use a local Postgres or the
# Railway-provided DATABASE_URL. Railway injects this automatically in prod.
DATABASE_URL=postgres://user:password@localhost:5432/csp

# Google OAuth 2.0 client (Google Cloud Console -> Credentials -> OAuth client, "Web application").
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an Authorized redirect URI on the OAuth client.
# Dev: http://localhost:8080/api/auth/google/callback
# Prod: https://<your-railway-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Where to send the user after a successful login (the SPA origin).
# Dev: http://localhost:5173   Prod: https://<your-railway-domain>
APP_URL=http://localhost:5173

# Random 32+ byte secret used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

PORT=8080
NODE_ENV=development
